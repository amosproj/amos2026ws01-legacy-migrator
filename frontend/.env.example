# Chat can use the backend; diff and auth remain mocked until their routes exist.
VITE_USE_MOCK_API=true
VITE_USE_MOCK_DIFF_API=true
VITE_USE_MOCK_AUTH_API=true
VITE_BACKEND_URL=http://localhost:8000
VITE_API_CHAT_PATH=/api/chat
VITE_API_DIFF_EXPLAIN_PATH=/api/diff/explain
VITE_API_REPOSITORIES_PATH=/api/repositories
VITE_API_HEALTH_PATH=/api/health
VITE_API_AUTH_SESSION_PATH=/api/auth/session
VITE_API_AUTH_START_PATH=/api/auth/{provider}/start
VITE_API_AUTH_LOGOUT_PATH=/api/auth/logout
VITE_MOCK_CHAT_DELAY_MS=650
VITE_MOCK_DIFF_DELAY_MS=450
VITE_MOCK_REPOSITORIES_DELAY_MS=250
