%% MA-CONTRACT-1.0 | Accepted design; implementation verification pending
%% Preserve existing schema. Offline local comparison MVP; future features explicitly marked.
    subgraph PROCESS["Instance snapshot - Python worker processing one analysis run"]
        WORKER["worker : IngestionWorker<br/>state = extracting"]
        ANALYSIS["analysis : AnalysisService"]
        GIT["git : GitRepositoryAdapter<br/>complete local objects / no network"]
        CRG["structure : CrgExtractorAdapter<br/>version = 2.3.9"]
        SQL["sql : SqlAccessExtractor<br/>library = sqlglot 30.22.0"]
        MD["markdown : MarkdownExtractor<br/>library = markdown-it-py"]
        FACTS["validator : CanonicalFactValidator<br/>library = pydantic"]
        STORE["store : AgePgvectorAdapter<br/>driver = asyncpg"]
        EMBED["embeddings : OllamaEmbeddingAdapter<br/>optional local retrieval extension"]
        RULES["rules : MigrationStatusEngine<br/>future assessment; not diff completion proof"]
        RUN["run : ExtractionRun<br/>state = running<br/>extractorVersion = 2.3.9"]
        SNAP["snapshot : AnalysisSnapshot<br/>snapshotId includes source/schema/extractor/config<br/>state = staging"]
    end
    WORKER ---|"analysis reference"| ANALYSIS
    ANALYSIS ---|"repository port"| GIT
    ANALYSIS ---|"structure extractor"| CRG
    ANALYSIS ---|"SQL extractor"| SQL
    ANALYSIS ---|"documentation extractor"| MD
    ANALYSIS ---|"fact validator"| FACTS
    ANALYSIS ---|"knowledge-store port"| STORE
    ANALYSIS -.-|"optional embedding port"| EMBED
    ANALYSIS -.-|"future status policy"| RULES
    WORKER ---|"current run"| RUN
    RUN ---|"staging snapshot"| SNAP

    STEP["selection : StepSelection<br/>projectId / stepId / ordinal<br/>repoId / origin / commitSha"]
    SOURCE["source : SourceSnapshot<br/>sourceSnapshotId = hash of repoId + commitSha"]
    STEP ---|"selects source; snapshot may be reused across steps"| SOURCE
    SNAP ---|"analysis of"| SOURCE
    WORKER ---|"current selection context"| STEP
