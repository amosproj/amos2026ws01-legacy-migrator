# Copy to .env (docker compose automatically reads ./.env) and adjust as needed.
# Out of the box, `docker compose up` starts with the built-in mock provider —
# no model endpoint required. Uncomment the LLM lines below to use a real LLM.

# Ports on the host
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEO4J_PORT=7687

# Frontend build arg — decoupled architecture: the browser calls the backend
# directly (no nginx proxy), so this must be reachable from the user's machine.
VITE_BACKEND_URL=http://localhost:8000

# LLM wiring — uncomment to point the backend at Ollama on the host
# (see backend/run.sh for the same wiring).
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_NAME=qwen3.5:0.8b
# LLM_EXTRA_BODY={"think": false}
# LLM_API_KEY= (only for external API providers)
